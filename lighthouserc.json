{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/",
        "http://localhost/services/",
        "http://localhost/services/business/sample-business-permit/",
        "http://localhost/hotlines/",
        "http://localhost/government/",
        "http://localhost/barangays/",
        "http://localhost/barangays/malinta/"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 1 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
