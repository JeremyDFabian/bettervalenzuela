{
  "name": "bettervalenzuela",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:build": "vitest run --config vitest.build.config.ts",
    "staleness": "node scripts/check-staleness.mjs",
    "sources": "node scripts/check-sources.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.5",
    "leaflet": "1.9.4",
    "lucide-static": "1.49.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@lhci/cli": "0.15.1",
    "@types/leaflet": "1.9.22",
    "@types/node": "24.19.0",
    "@typescript-eslint/parser": "8.71.0",
    "eslint": "10.11.0",
    "eslint-plugin-astro": "3.2.1",
    "linkinator": "8.1.0",
    "pagefind": "1.5.2",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
