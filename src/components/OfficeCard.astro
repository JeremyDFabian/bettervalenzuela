---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import PhoneActions from './PhoneActions.astro';
import { t } from '../i18n/t';
import { site } from '../site.config';

/**
 * Approved office card (7f C): icon, name, location, hours, and an "Open now" status that a
 * script computes from the structured schedule. Without the script, the hours text shows alone.
 */
interface Props {
  office: CollectionEntry<'offices'>;
}

const { office } = Astro.props;
const { name, location, phones, email, hours, schedule } = office.data;
const directions = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  `${name}, ${location}, ${site.cityFullName}`,
)}`;
const labels = {
  open: t('office.openNow'),
  closes: t('office.closes'),
  closed: t('office.closedNow'),
  opensToday: t('office.opensToday'),
  opensOn: t('office.opensOn'),
  days: {
    mon: t('office.day.mon'),
    tue: t('office.day.tue'),
    wed: t('office.day.wed'),
    thu: t('office.day.thu'),
    fri: t('office.day.fri'),
    sat: t('office.day.sat'),
    sun: t('office.day.sun'),
  },
};
---

<div class="office">
  <div class="top">
    <span class="tile">
      <Icon name="office" size={22} />
    </span>
    <div class="text">
      <p class="name">{name}</p>
      <p class="line">{location}</p>
      <p class="line">{hours}</p>
      {phones.length > 1 && (
        <p class="line">{t('office.also', { numbers: phones.slice(1).join(', ') })}</p>
      )}
      {email && (
        <p class="line">
          <a href={`mailto:${email}`}>{email}</a>
        </p>
      )}
      {schedule.length > 0 && (
        <p
          class="status"
          hidden
          data-office-status
          data-schedule={JSON.stringify(schedule)}
          data-labels={JSON.stringify(labels)}
        />
      )}
    </div>
  </div>
  <div class="bar">
    {phones.length > 0 && (
      <div class="phones">
        <PhoneActions numbers={phones} {name} id={`office-${office.id}`} />
      </div>
    )}
    <a class="directions" href={directions} rel="external">
      <Icon name="navigation" size={14} />
      {t('office.directions')}
    </a>
  </div>
</div>

<script>
  import { formatClock, officeStatus, type ScheduleSlot } from '../lib/hours';

  interface Labels {
    open: string;
    closes: string;
    closed: string;
    opensToday: string;
    opensOn: string;
    days: Record<string, string>;
  }

  const fill = (template: string, values: Record<string, string>) =>
    template.replace(/\{(\w+)\}/g, (_, key: string) => values[key] ?? '');

  for (const el of document.querySelectorAll<HTMLElement>('[data-office-status]')) {
    const schedule = JSON.parse(el.dataset.schedule ?? '[]') as ScheduleSlot[];
    const labels = JSON.parse(el.dataset.labels ?? '{}') as Labels;
    const status = officeStatus(schedule, new Date());
    if (!status) continue;

    const dot = document.createElement('i');
    const detail = document.createElement('span');
    if (status.open) {
      detail.textContent = ` · ${fill(labels.closes, { time: formatClock(status.closes) })}`;
      el.append(dot, labels.open, detail);
    } else {
      const { day, time, today } = status.opens;
      const template = today ? labels.opensToday : labels.opensOn;
      detail.textContent = ` · ${fill(template, { day: labels.days[day] ?? day, time: formatClock(time) })}`;
      el.classList.add('closed');
      el.append(dot, labels.closed, detail);
    }
    el.hidden = false;
  }
</script>

<style>
  .office {
    max-width: 520px;
    overflow: hidden;
    border: 1px solid #ececf0;
    border-radius: 14px;
    background: var(--color-bg);
    box-shadow: var(--shadow-card);
  }
  .top {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 12px;
    padding: 16px 18px;
  }
  .tile {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-lg);
    background: var(--color-band-soft);
    color: var(--color-primary);
  }
  .name {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .line {
    margin-top: 2px;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 6px;
    font-size: 0.78125rem;
    font-weight: 600;
    color: var(--color-ok);
  }
  .status :global(i) {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #30d158;
  }
  .status :global(span) {
    font-weight: 400;
    color: var(--color-muted);
  }
  .status.closed {
    color: var(--color-text-2);
  }
  .status.closed :global(i) {
    background: #aeaeb2;
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    padding: 12px 18px;
    border-top: 1px solid #ececf0;
    background: var(--color-surface);
  }
  .phones {
    flex: 1 1 100%;
  }
  .directions {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    flex: 1 1 100%;
    height: var(--tap-min);
    padding: 0 14px;
    border-radius: 10px;
    background: var(--color-bg);
    box-shadow: inset 0 0 0 1px var(--color-border-strong);
    color: var(--color-text);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }
  .directions:hover {
    color: var(--color-text);
    background: var(--color-surface-hover);
  }
  @media (min-width: 48rem) {
    .phones {
      flex: 0 1 260px;
    }
    .directions {
      flex: none;
      height: 36px;
      font-size: 0.78125rem;
    }
  }
</style>
