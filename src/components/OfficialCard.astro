---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import PhoneActions from './PhoneActions.astro';
import ReviewBadge from './ReviewBadge.astro';
import { t, type MessageKey } from '../i18n/t';
import { formatDate } from '../lib/format';

/**
 * Approved official card (lab ch16): a portrait frame, name, position, term, and phones.
 * Without a photo the frame shows a thin user icon. `large` is the executive portrait.
 */
interface Props {
  official: CollectionEntry<'officials'>;
  variant?: 'medium' | 'large' | undefined;
  showTerm?: boolean | undefined;
}

const { official, variant = 'medium', showTerm = true } = Astro.props;
const { name, position, district, role, termStart, termEnd, contact, photo, status } =
  official.data;
const large = variant === 'large';
const positionLine =
  position === 'ex-officio'
    ? (role ?? '')
    : t(`gov.position.${position}` as MessageKey, { n: district ?? '' });
const term = t('gov.term', { start: formatDate(termStart), end: formatDate(termEnd) });
const phones = contact?.phones ?? [];
---

<article class:list={['official', variant]}>
  <div class="frame">
    {photo ? (
      <Image
        src={photo}
        alt={name}
        width={large ? 272 : 144}
        height={large ? 340 : 180}
        loading="lazy"
      />
    ) : (
      <span class="blank">
        <Icon name="user" size={large ? 40 : 24} />
      </span>
    )}
  </div>
  <div class="text">
    <h3>{name}</h3>
    <p class="position">{positionLine}</p>
    {showTerm && <p class="term">{term}</p>}
    {status === 'needs-review' && <ReviewBadge />}
    {phones.length > 0 && <PhoneActions numbers={phones} {name} id={official.id} />}
  </div>
</article>

<style>
  .official {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px;
    border-radius: 14px;
    background: var(--official-card-bg, var(--color-surface));
  }
  .official.large {
    gap: 20px;
    padding: 18px;
  }
  .frame {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 90px;
    overflow: hidden;
    border-radius: 12px;
    background: var(--official-frame-bg, var(--color-bg));
  }
  .large .frame {
    width: 104px;
    height: 130px;
    border-radius: 16px;
  }
  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .blank {
    display: flex;
    color: var(--color-border-strong);
  }
  .blank :global(svg) {
    stroke-width: 1.25;
  }
  .large .blank :global(svg) {
    stroke-width: 1;
  }
  .text {
    min-width: 0;
  }
  h3 {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .large h3 {
    font-size: 1.1875rem;
    letter-spacing: -0.01em;
  }
  .position {
    font-size: 0.8125rem;
    color: var(--color-text-2);
  }
  .term {
    font-size: 0.78125rem;
    color: var(--color-muted);
  }
  .text :global([data-phone-actions]) {
    margin-top: 10px;
  }
  @media (min-width: 40rem) {
    .large .frame {
      width: 136px;
      height: 170px;
    }
  }
</style>
