---
import Icon from './Icon.astro';
import { t } from '../i18n/t';

/** Approved service card (7h B): name, one line, then fee and processing time. */
interface Props {
  href: string;
  title: string;
  summary: string;
  fee: string;
  free: boolean;
  processingTime: string;
}

const { href, title, summary, fee, free, processingTime } = Astro.props;
---

<a class="card" {href}>
  <span class="name">{title}</span>
  <span class="summary">{summary}</span>
  <span class="meta">
    <span class:list={['fact', { free }]}>
      <Icon name="wallet" size={13} />
      <span class="visually-hidden">{t('services.feeLabel')}</span>
      {fee}
    </span>
    <span class="fact">
      <Icon name="clock" size={13} />
      <span class="visually-hidden">{t('services.timeLabel')}</span>
      {processingTime}
    </span>
  </span>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    height: 100%;
    padding: var(--space-4);
    border: 1px solid #ececf0;
    border-radius: 14px;
    background: var(--color-bg);
    box-shadow: var(--shadow-card);
    color: var(--color-text);
    text-decoration: none;
    transition:
      box-shadow 0.2s,
      transform 0.2s;
  }
  .card:hover {
    box-shadow:
      0 2px 4px rgb(0 0 0 / 0.05),
      0 10px 24px rgb(0 0 0 / 0.07);
    transform: translateY(-1px);
    color: var(--color-text);
  }
  .name {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .summary {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--color-muted);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    margin-top: auto;
    padding-top: 10px;
    border-top: 1px solid #f0f0f2;
    font-size: 0.75rem;
    color: var(--color-text-2);
  }
  .fact {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .fact :global(.icon) {
    color: var(--color-muted);
  }
  .free {
    color: var(--color-ok);
  }
  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }
    .card:hover {
      transform: none;
    }
  }
</style>
