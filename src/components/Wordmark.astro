---
import { site } from '../site.config';
// Text wordmark until the logo file exists (spec §6.3). Replace this markup with the logo then.
---

<a class="wordmark" href="/">
  {site.portalName}
</a>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    font-size: 1.1875rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text);
    text-decoration: none;
    white-space: nowrap;
  }
</style>
