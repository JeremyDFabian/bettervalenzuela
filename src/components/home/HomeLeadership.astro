---
import OfficialCard from '../OfficialCard.astro';
import { t } from '../../i18n/t';
import { getPublished } from '../../lib/content';
import { groupOfficials } from '../../lib/officials';

/** Approved home leadership band (lab ch20): mayor and vice mayor as white cards on a gray band. */
const { executive } = groupOfficials(await getPublished('officials'));
---

{executive.length > 0 && (
  <section
    class="block"
    data-home-block="leadership"
    aria-labelledby="home-leaders-h"
    style="--official-card-bg: var(--color-bg); --official-frame-bg: var(--color-surface);"
  >
    <div class="inner">
      <div class="head">
        <h2 id="home-leaders-h">{t('home.leaders.title')}</h2>
        <a class="more" href="/government/">
          {t('home.leaders.more')} ›
        </a>
      </div>
      <div class="cards">
        {executive.map((official) => (
          <OfficialCard official={official} variant="large" showTerm={false} />
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .block {
    padding: 48px 22px;
    background: var(--color-surface);
  }
  .inner {
    max-width: 980px;
    margin: 0 auto;
  }
  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 16px;
  }
  h2 {
    margin: 0;
    font-size: 1.75rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .more {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    font-size: 0.9375rem;
    color: var(--color-link);
    white-space: nowrap;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }
  @media (max-width: 47.99rem) {
    .block {
      padding: 36px 16px;
    }
  }
  @media (max-width: 39.99rem) {
    .head {
      flex-direction: column;
      gap: 0;
    }
    h2 {
      font-size: 1.5rem;
    }
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
