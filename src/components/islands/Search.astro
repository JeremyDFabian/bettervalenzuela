---
import Icon from '../Icon.astro';
import { t } from '../../i18n/t';
---

<form
  class="xs"
  role="search"
  action="/search/"
  method="get"
  data-site-search
  data-placeholder-open={t('search.placeholder')}
  data-placeholder-closed={t('search.quick')}
  data-see-all={t('search.seeAll')}
  data-top={t('search.top')}
>
  <Icon name="search" size={16} class="xs-i" />
  <input
    type="search"
    name="q"
    aria-label={t('search.label')}
    placeholder={t('search.quick')}
    autocomplete="off"
    enterkeyhint="search"
  />
  <kbd class="xs-k" aria-hidden="true">
    <span data-mod>Ctrl</span> K
  </kbd>
  <button type="button" class="xs-x" hidden aria-label={t('search.clear')}>
    <Icon name="close" size={14} />
  </button>
  <div class="xs-panel" hidden></div>
</form>

<script>
  import { searchSite } from '../../lib/pagefind-client';

  const isMac = /Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent);

  document.querySelectorAll<HTMLFormElement>('[data-site-search]').forEach((form) => {
    const input = form.querySelector('input') as HTMLInputElement;
    const clear = form.querySelector('.xs-x') as HTMLButtonElement;
    const badge = form.querySelector('.xs-k') as HTMLElement;
    const panel = form.querySelector('.xs-panel') as HTMLElement;
    const mod = form.querySelector('[data-mod]');
    if (mod && isMac) mod.textContent = '⌘';
    let timer: number | undefined;
    let seq = 0;

    const setPlaceholder = () => {
      const open = document.activeElement === input || input.value !== '';
      input.placeholder =
        (open ? form.dataset['placeholderOpen'] : form.dataset['placeholderClosed']) ?? '';
    };
    const syncEnd = () => {
      clear.hidden = input.value === '';
      badge.hidden = input.value !== '';
    };
    const close = () => {
      panel.hidden = true;
      panel.replaceChildren();
    };

    const render = async (query: string) => {
      const mine = ++seq;
      const result = await searchSite(query, 5);
      if (mine !== seq || !result || result.hits.length === 0 || input.value.trim() === '') {
        if (mine === seq) close();
        return;
      }
      const heading = document.createElement('p');
      heading.className = 'xs-h';
      heading.textContent = form.dataset['top'] ?? '';
      const list = document.createElement('ul');
      for (const hit of result.hits) {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = hit.url;
        const title = document.createElement('b');
        title.textContent = hit.title;
        const excerpt = document.createElement('span');
        excerpt.innerHTML = hit.excerpt; // Pagefind output from our own index (<mark> only).
        a.append(title, excerpt);
        if (hit.section) {
          const section = document.createElement('small');
          section.textContent = hit.section;
          a.append(section);
        }
        li.append(a);
        list.append(li);
      }
      const all = document.createElement('a');
      all.className = 'xs-all';
      all.href = `/search/?q=${encodeURIComponent(query)}`;
      all.textContent = (form.dataset['seeAll'] ?? '').replace('{q}', query);
      panel.replaceChildren(heading, list, all);
      panel.hidden = false;
    };

    input.addEventListener('input', () => {
      syncEnd();
      window.clearTimeout(timer);
      const query = input.value.trim();
      if (query.length < 2) {
        close();
        return;
      }
      timer = window.setTimeout(() => void render(query), 150);
    });
    input.addEventListener('focus', setPlaceholder);
    input.addEventListener('blur', () => {
      setPlaceholder();
      window.setTimeout(() => {
        if (!form.contains(document.activeElement)) close();
      }, 150);
    });
    input.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        input.value = '';
        syncEnd();
        close();
        input.blur();
      }
    });
    clear.addEventListener('mousedown', (event) => event.preventDefault());
    clear.addEventListener('click', () => {
      input.value = '';
      syncEnd();
      close();
      input.focus();
    });
    syncEnd();
  });

  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      const input = document.querySelector<HTMLInputElement>('[data-site-search] input');
      if (input && input.offsetParent !== null) {
        event.preventDefault();
        input.focus();
      }
    }
  });
</script>

<style>
  .xs {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    width: 180px;
    padding: 0 10px 0 12px;
    border-radius: var(--radius-lg);
    background: var(--color-field);
    cursor: text;
    transition:
      width 0.32s cubic-bezier(0.34, 1.4, 0.64, 1),
      background-color 0.2s,
      box-shadow 0.2s;
  }
  .xs:hover {
    background: #e8e8ed;
  }
  .xs:focus-within,
  .xs:has(input:not(:placeholder-shown)) {
    width: 300px;
    background: var(--color-bg);
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.05),
      0 6px 20px rgb(0 0 0 / 0.1);
  }
  .xs :global(.xs-i) {
    color: var(--color-muted);
  }
  input {
    flex: 1;
    min-width: 0;
    height: 100%;
    border: 0;
    background: transparent;
    font: inherit;
    font-size: var(--text-sm);
    color: var(--color-text);
    outline: none;
  }
  input::placeholder {
    color: #6e6e73;
  }
  input::-webkit-search-cancel-button {
    display: none;
  }
  .xs-k {
    display: inline-flex;
    gap: 3px;
    padding: 1px 6px;
    border-radius: 5px;
    background: rgb(0 0 0 / 0.06);
    font:
      0.6875rem ui-monospace,
      SFMono-Regular,
      Consolas,
      monospace;
    color: var(--color-muted);
  }
  .xs-x {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    margin-right: -4px;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
  }
  .xs-x:hover {
    background: var(--color-surface);
    color: var(--color-text);
  }
  [hidden] {
    display: none !important;
  }
  .xs-panel {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    z-index: 60;
    width: min(460px, 92vw);
    padding: 8px;
    border: 1px solid #e5e5ea;
    border-radius: var(--radius-xl);
    background: var(--color-bg);
    box-shadow: var(--shadow-pop);
  }
  .xs-panel :global(.xs-h) {
    padding: 8px 12px 4px;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-muted);
  }
  .xs-panel :global(ul) {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .xs-panel :global(li a) {
    display: block;
    padding: 10px 12px;
    border-radius: var(--radius-md);
    color: var(--color-text);
    text-decoration: none;
  }
  .xs-panel :global(li a:hover),
  .xs-panel :global(li a:focus-visible) {
    background: var(--color-surface);
  }
  .xs-panel :global(li b) {
    display: block;
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .xs-panel :global(li span) {
    display: block;
    font-size: 0.8125rem;
    color: var(--color-muted);
    line-height: 1.4;
  }
  .xs-panel :global(mark) {
    background: #fff3b0;
    color: inherit;
    border-radius: 3px;
  }
  .xs-panel :global(li small) {
    display: block;
    margin-top: 2px;
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
  .xs-panel :global(.xs-all) {
    display: flex;
    align-items: center;
    min-height: var(--tap-min);
    margin-top: 6px;
    padding: 0 12px;
    border-top: 1px solid #e5e5ea;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-link);
    text-decoration: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .xs {
      transition: none;
    }
  }
</style>
