---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ReviewBadge from '../components/ReviewBadge.astro';
import SourceLine from '../components/SourceLine.astro';
import { site } from '../site.config';
import { buildIssueUrl } from '../lib/issues';
import type { Status } from '../lib/drafts';
import type { Crumb, Source } from '../lib/types';

/** The approved "direct" content template: breadcrumb, title, content, one quiet source line. */
interface Props {
  title: string;
  description?: string | undefined;
  breadcrumbs: Crumb[];
  status?: Status | undefined;
  lastVerified?: Date | undefined;
  sources?: Source[] | undefined;
  jsonLd?: Record<string, unknown> | undefined;
  section?: string | undefined;
}

const {
  title,
  description,
  breadcrumbs,
  status,
  lastVerified,
  sources = [],
  jsonLd,
  section,
} = Astro.props;
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? site.url).toString();
const issueUrl = buildIssueUrl(site.repoUrl, { title, url: pageUrl });
---

<BaseLayout {title} {description} {jsonLd} {section} noindex={status === 'needs-review'}>
  <div class="narrow page">
    <Breadcrumb items={breadcrumbs} />
    <h1>{title}</h1>
    {status === 'needs-review' && <ReviewBadge />}
    <div class="content">
      <slot />
    </div>
    <SourceLine {sources} {lastVerified} {issueUrl} />
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: 20px var(--space-8);
  }
  h1 {
    margin-top: var(--space-1);
    font-size: var(--text-2xl);
    font-weight: 600;
  }
  .content {
    margin-top: var(--space-6);
  }
</style>
