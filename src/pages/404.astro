---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';
import { t } from '../i18n/t';
---

<BaseLayout title={t('notFound.title')} noindex>
  <div class="nf">
    <p class="code" aria-hidden="true">
      404
    </p>
    <h1>{t('notFound.title')}</h1>
    <p class="lead">{t('notFound.lead')}</p>
    <div class="bts">
      <a class="btn btn-primary" href="/">
        {t('notFound.home')}
      </a>
      <a class="btn btn-outline" href={`${site.repoUrl}/issues/new/choose`} rel="external">
        {t('notFound.report')}
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .nf {
    padding: 96px var(--space-4) 120px;
    text-align: center;
  }
  .code {
    font-size: clamp(8rem, 5rem + 12vw, 13.75rem);
    line-height: 1;
    font-weight: 700;
    letter-spacing: -0.05em;
    color: #a9cdf5;
  }
  h1 {
    margin-top: var(--space-2);
    font-size: clamp(2.125rem, 1.6rem + 2vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .lead {
    margin: var(--space-3) auto 0;
    max-width: 38ch;
    font-size: var(--text-lg);
    color: var(--color-muted);
  }
  .bts {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: var(--space-6);
  }
  @media (max-width: 47.99rem) {
    .nf {
      padding-block: 64px 72px;
    }
    .bts .btn {
      flex: 1 1 100%;
    }
  }
</style>
