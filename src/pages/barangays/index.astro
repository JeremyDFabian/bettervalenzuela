---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BarangayRow from '../../components/BarangayRow.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Icon from '../../components/Icon.astro';
import ReviewBadge from '../../components/ReviewBadge.astro';
import SegmentedNav from '../../components/SegmentedNav.astro';
import SourceLine from '../../components/SourceLine.astro';
import { site } from '../../site.config';
import { t } from '../../i18n/t';
import { getPublished } from '../../lib/content';
import { buildIssueUrl } from '../../lib/issues';
import { mergeSources } from '../../lib/sources';

/**
 * Approved barangay directory (lab ch17): soft blue band, one section per district, and one merged
 * source line. While nothing is verified, production shows a notice.
 */
const barangays = (await getPublished('barangays')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name, 'en'),
);
const districts = [1, 2]
  .map((n) => ({ n, entries: barangays.filter((b) => b.data.district === n) }))
  .filter((group) => group.entries.length > 0);
const { sources, lastVerified } = mergeSources(barangays.map((entry) => entry.data));

const navItems = districts.map((group) => ({
  id: `district-${group.n}`,
  label: t('brgy.districtCount', { n: group.n, count: group.entries.length }),
}));

const pageUrl = new URL('/barangays/', Astro.site ?? site.url).toString();
const issueUrl = buildIssueUrl(site.repoUrl, { title: t('brgy.title'), url: pageUrl });
const noindex = barangays.some((entry) => entry.data.status === 'needs-review');
---

<BaseLayout
  title={t('brgy.title')}
  description={t('brgy.description')}
  section="barangays"
  {noindex}
>
  <div class:list={['band', { 'has-nav': navItems.length > 1 }]}>
    <div class="inner">
      <Breadcrumb items={[{ label: t('nav.home'), href: '/' }, { label: t('brgy.title') }]} />
      <h1>{t('brgy.title')}</h1>
      <p class="lede">{t('brgy.intro')}</p>
      {noindex && <ReviewBadge />}
      {navItems.length > 1 && <SegmentedNav label={t('brgy.jumpTo')} items={navItems} />}
    </div>
  </div>

  <div class="body">
    <div class="inner">
      {districts.length === 0 && (
        <div class="wait">
          <span class="tile">
            <Icon name="safety" size={20} />
          </span>
          <div>
            <p class="wait-title">{t('brgy.pending')}</p>
            <p>{t('brgy.pendingNote')}</p>
            <a href={site.officialWebsite} rel="external">
              {t('footer.official')} ↗
            </a>
          </div>
        </div>
      )}

      {districts.map((group) => (
        <section id={`district-${group.n}`} aria-labelledby={`district-${group.n}-h`}>
          <h2 id={`district-${group.n}-h`}>{t('brgy.district', { n: group.n })}</h2>
          <ul class="rows">
            {group.entries.map((barangay) => (
              <li>
                <BarangayRow {barangay} />
              </li>
            ))}
          </ul>
        </section>
      ))}

      {districts.length > 0 && <SourceLine {sources} {lastVerified} {issueUrl} />}
    </div>
  </div>
</BaseLayout>

<style>
  .band {
    padding: 0 16px 22px;
    border-bottom: 1px solid var(--color-band-soft-edge);
    background: var(--color-band-soft);
  }
  .inner {
    width: 100%;
    max-width: 61.25rem;
    margin-inline: auto;
  }
  .band .inner {
    padding-top: 20px;
  }
  .body {
    padding: 4px 16px 64px;
  }
  .band.has-nav {
    padding-bottom: 0;
    border-bottom: 0;
  }
  h1 {
    margin: 12px 0 6px;
    font-size: var(--text-2xl);
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .lede {
    max-width: 52ch;
    margin-bottom: 18px;
    font-size: 1.0625rem;
    line-height: 1.4;
    color: var(--color-muted);
  }
  section {
    scroll-margin-top: var(--space-6);
  }
  h2 {
    margin: 32px 0 10px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .rows {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rows > li > :global(*) {
    height: 100%;
  }
  .wait {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 640px;
    margin-top: 28px;
    padding: 18px;
    border-radius: 14px;
    background: var(--color-surface);
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-text-2);
  }
  .tile {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-primary);
  }
  .wait-title {
    margin-bottom: 4px;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
  }
  .wait a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    font-weight: 600;
    color: var(--color-link);
    text-decoration: none;
  }
  @media (min-width: 40rem) {
    .rows {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 48rem) {
    .band {
      padding: 0 22px 28px;
    }
    .band.has-nav {
      padding-bottom: 28px;
      border-bottom: 1px solid var(--color-band-soft-edge);
    }
    .body {
      padding-inline: 22px;
    }
    .wait {
      flex-direction: row;
      padding: 20px;
    }
  }
  @media (min-width: 60rem) {
    .rows {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
