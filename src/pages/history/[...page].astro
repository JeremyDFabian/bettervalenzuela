---
import InfoLayout from '../../layouts/InfoLayout.astro';
import ReviewBadge from '../../components/ReviewBadge.astro';
import SourceLine from '../../components/SourceLine.astro';
import Timeline from '../../components/Timeline.astro';
import { site } from '../../site.config';
import { t } from '../../i18n/t';
import { getPublished } from '../../lib/content';
import { sortedTimeline } from '../../lib/history';
import { buildIssueUrl } from '../../lib/issues';

/** Built only when history is published, so production has no /history/ while it needs review. */
export async function getStaticPaths() {
  const entry = (await getPublished('history'))[0];
  return entry ? [{ params: { page: undefined }, props: { entry } }] : [];
}

const { entry } = Astro.props;
const needsReview = entry.data.status === 'needs-review';
const pageUrl = new URL('/history/', Astro.site ?? site.url).toString();
const issueUrl = buildIssueUrl(site.repoUrl, { title: t('history.title'), url: pageUrl });
---

<InfoLayout
  title={t('history.title')}
  description={t('history.description')}
  lede={t('history.lede')}
  showUpdated={false}
  noindex={needsReview}
>
  {needsReview && <ReviewBadge tone="onColor" slot="band" />}
  <Timeline events={sortedTimeline(entry.data.timeline)} />
  <SourceLine
    sources={entry.data.sources}
    lastVerified={entry.data.lastVerified}
    issueUrl={issueUrl}
  />
</InfoLayout>
