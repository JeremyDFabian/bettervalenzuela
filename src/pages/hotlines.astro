---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Icon from '../components/Icon.astro';
import PhoneActions from '../components/PhoneActions.astro';
import ReviewBadge from '../components/ReviewBadge.astro';
import SegmentedNav from '../components/SegmentedNav.astro';
import SourceLine from '../components/SourceLine.astro';
import { site } from '../site.config';
import { t } from '../i18n/t';
import { getPublished } from '../lib/content';
import { groupByCategory, type HotlineEntry } from '../lib/hotlines';
import { buildIssueUrl } from '../lib/issues';

/**
 * Approved hotlines page: centered title, segmented jump control, groups of same-size cards.
 * 911 is always offered. While the city hotlines are unverified, production shows only the
 * Emergency group and a notice (approved "being verified" state).
 */
const [hotlines] = await getPublished('hotlines');
const groups = groupByCategory(hotlines?.data.entries ?? []);

const national911: HotlineEntry = {
  name: t('hotlines.national911Name'),
  category: 'emergency',
  numbers: ['911'],
  note: t('hotlines.national911Note'),
};
const emergency = groups.find((group) => group.category === 'emergency');
if (!emergency) {
  groups.unshift({ category: 'emergency', entries: [national911] });
} else if (!emergency.entries.some((entry) => entry.numbers.includes('911'))) {
  emergency.entries.unshift(national911);
}

const pageUrl = new URL('/hotlines/', Astro.site ?? site.url).toString();
const issueUrl = buildIssueUrl(site.repoUrl, { title: t('hotlines.title'), url: pageUrl });
---

<BaseLayout
  title={t('hotlines.title')}
  description={t('hotlines.description')}
  section="hotlines"
  noindex={hotlines?.data.status === 'needs-review'}
>
  <div class="wrap page">
    <Breadcrumb items={[{ label: t('nav.home'), href: '/' }, { label: t('hotlines.title') }]} />
    <div class="top">
      <h1>{t('hotlines.title')}</h1>
      {hotlines?.data.status === 'needs-review' && <ReviewBadge />}
      {groups.length > 1 && (
        <SegmentedNav
          label={t('hotlines.jumpTo')}
          items={groups.map((group) => ({
            id: group.category,
            label: t(`hotlines.category.${group.category}`),
          }))}
        />
      )}
    </div>

    {groups.map((group) => (
      <section id={group.category} aria-labelledby={`${group.category}-h`}>
        <h2 id={`${group.category}-h`}>{t(`hotlines.category.${group.category}`)}</h2>
        <ul class="cards">
          {group.entries.map((entry, index) => (
            <li class="card">
              <p class="name">{entry.name}</p>
              <p class="note">{entry.note ?? t('hotlines.officeLine')}</p>
              <PhoneActions
                numbers={entry.numbers}
                name={entry.name}
                id={`${group.category}-${index}`}
                tone={entry.numbers.includes('911') ? 'danger' : undefined}
              />
            </li>
          ))}
        </ul>
      </section>
    ))}

    {!hotlines && (
      <div class="wait">
        <span class="tile">
          <Icon name="safety" size={20} />
        </span>
        <div>
          <p class="wait-title">{t('hotlines.pending')}</p>
          <p>{t('hotlines.pendingNote')}</p>
          <a href={site.officialWebsite} rel="external">
            {t('footer.official')} ↗
          </a>
        </div>
      </div>
    )}

    <SourceLine
      sources={hotlines?.data.sources ?? []}
      lastVerified={hotlines?.data.lastVerified}
      {issueUrl}
    />
  </div>
</BaseLayout>

<style>
  .wrap {
    width: 100%;
    max-width: 61.25rem;
    margin-inline: auto;
    padding-inline: var(--space-4);
  }
  .page {
    padding-block: 20px var(--space-8);
  }
  h1 {
    margin: var(--space-1) 0 var(--space-2);
    font-size: var(--text-2xl);
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .top :global(.seg) {
    margin-top: var(--space-2);
  }
  section {
    scroll-margin-top: var(--space-6);
  }
  h2 {
    margin: var(--space-6) 0 10px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .card {
    display: flex;
    flex-direction: column;
    padding: 14px;
    border-radius: 14px;
    background: var(--color-surface);
  }
  .name,
  .note {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .name {
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .note {
    margin: 2px 0 10px;
    font-size: 0.78125rem;
    color: var(--color-muted);
  }
  .card :global([data-phone-actions]) {
    margin-top: auto;
  }
  .wait {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 640px;
    margin-top: 28px;
    padding: 18px;
    border-radius: 14px;
    background: var(--color-surface);
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-text-2);
  }
  .tile {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-primary);
  }
  .wait-title {
    margin-bottom: 4px;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
  }
  .wait a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    font-weight: 600;
    color: var(--color-link);
    text-decoration: none;
  }
  @media (min-width: 40rem) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 48rem) {
    .wrap {
      padding-inline: 22px;
    }
    .top {
      text-align: center;
    }
    .top :global(.review-badge) {
      text-align: center;
    }
    .wait {
      flex-direction: row;
      padding: 20px;
    }
  }
  @media (min-width: 60rem) {
    .cards {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
